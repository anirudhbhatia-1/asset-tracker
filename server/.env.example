# Local development settings. Copy to server/.env.
# Never put the production database address in development settings.
PORT=3001
NODE_ENV=development

# Local database started by `npm run dev` (embedded PostgreSQL 17).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Optional: local database port and API pool size.
# DEV_DB_PORT=54322
# DB_POOL_MAX=10
# Optional: cancel any single query after this many ms (default 30000).
# DB_STATEMENT_TIMEOUT_MS=30000
# Optional: per-IP ceiling on all /api requests per minute (default 1200).
# API_RATE_LIMIT_IP_PER_MINUTE=1200

# CORS: the web app's origin.
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 only when the app is behind the supplied single-hop reverse proxy.
TRUST_PROXY_HOPS=

# Google Identity Services. Must equal the client's VITE_GOOGLE_CLIENT_ID.
# Production requires GOOGLE_ALLOWED_DOMAIN unless
# GOOGLE_ALLOW_EXTERNAL_ACCOUNTS=true is explicitly set.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=thinkvibes.com
GOOGLE_ALLOW_EXTERNAL_ACCOUNTS=false

# Email domains that may be given a login (comma-separated).
LOGIN_EMAIL_DOMAINS=company.com,thinkvibes.com

# People Portal link (optional): a random key of at least 32 characters turns on
# the read-only /api/integration routes. Unset = those routes answer 404.
# PEOPLE_PORTAL_API_KEY=

# Business timezone for "today" defaults (optional).
# APP_TIMEZONE=Asia/Kolkata
