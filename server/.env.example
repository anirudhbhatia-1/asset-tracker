# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (Supabase Session Pooler URL - Port 5432)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-xx.pooler.supabase.com:5432/postgres

# Security & CORS
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-in-production
# Set to 1 only when the app is behind the supplied single-hop reverse proxy.
TRUST_PROXY_HOPS=

# Google Identity Services. Production requires GOOGLE_ALLOWED_DOMAIN unless
# GOOGLE_ALLOW_EXTERNAL_ACCOUNTS=true is explicitly set.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=company.com
GOOGLE_ALLOW_EXTERNAL_ACCOUNTS=false
