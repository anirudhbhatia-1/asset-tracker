# ==========================================
# AssetTrack Production Environment Template
# ==========================================
# Rename this file to `.env` on your production server.
# Ensure this file is NEVER committed to source control!

# App Environment
NODE_ENV=production
PORT=3001

# Database Configuration
# In production, use an absolute path outside the ephemeral app directory
# e.g. /var/lib/assettrack/assets.db
DB_PATH=./data/assets.db

# Frontend URL (For CORS policies)
# Change this to your production domain name where the frontend is hosted
CLIENT_ORIGIN=https://assettrack.yourcompany.com

# Authentication (If you implement JWT or session-based auth later)
JWT_SECRET=generate_a_long_random_string_here

# Third-party integrations
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
