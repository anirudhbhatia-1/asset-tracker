# ==========================================
# AssetTrack Production Environment Template
# ==========================================
# Rename this file to `.env` on your production server.
# Ensure this file is NEVER committed to source control!

# App Environment
NODE_ENV=production
PORT=3001

# Database Configuration (Supabase/PostgreSQL session pooler URL)
DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:5432/postgres

# Frontend URL (For CORS policies)
# Change this to your production domain name where the frontend is hosted
CLIENT_ORIGIN=https://assettrack.yourcompany.com
# Supplied Nginx deployment uses one trusted proxy hop for correct rate limits.
TRUST_PROXY_HOPS=1

# Google Identity Services
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAIN=company.com
GOOGLE_ALLOW_EXTERNAL_ACCOUNTS=false
