# Example Nginx configuration for AssetTrack (static web app + API proxy).
# Works with the nginx that Ubuntu 22.04/24.04 install (`listen … http2`;
# on nginx 1.25.1+ you may switch to `listen 443 ssl;` + `http2 on;`).
#
# Setup on the VM:
#   sudo cp nginx-security-headers.conf.example /etc/nginx/snippets/assettrack-security-headers.conf
#   sudo cp nginx.conf.example /etc/nginx/sites-available/assettrack   (edit server_name / paths)
#   sudo ln -s /etc/nginx/sites-available/assettrack /etc/nginx/sites-enabled/assettrack
#   sudo nginx -t && sudo systemctl reload nginx
#
# Caching strategy:
#   /assets/*.{js,css,...}  Vite output with a content hash in the file name:
#                           cached for a year and marked immutable.
#   index.html + SPA routes  `no-cache`: the browser revalidates on every load,
#                           so a new deploy is picked up immediately.
#   other files in dist/     (favicon, logo, CSV template) `no-cache` too; they
#                           are small and revalidation is a cheap 304.
#
# IMPORTANT (add_header inheritance): a location that has any `add_header`
# does NOT inherit the server-level ones. Every such location below includes
# the security-header snippet again — keep it that way when editing.

server {
    # Redirect HTTP to HTTPS
    listen 80;
    server_name assettrack.yourcompany.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name assettrack.yourcompany.com;

    # SSL Configuration (assuming Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/assettrack.yourcompany.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/assettrack.yourcompany.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Excel imports are allowed up to 10 MB and CSV up to 5 MB by the API;
    # nginx's default (1 MB) would reject them first.
    client_max_body_size 12m;

    # Security headers for every response that does not set its own headers
    # (the /api proxy, redirects, nginx error pages).
    include /etc/nginx/snippets/assettrack-security-headers.conf;

    # Compression. gzip is built into nginx.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/xml+rss application/manifest+json image/svg+xml;

    # Brotli needs the ngx_brotli module (not in stock nginx; on Debian/Ubuntu
    # `apt install libnginx-mod-http-brotli-filter libnginx-mod-http-brotli-static`).
    # Uncomment once the module is installed:
    # brotli on;
    # brotli_comp_level 5;
    # brotli_types text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml;

    # 1. Serve the built web app (client/dist after `npm run build`)
    root /var/www/assettrack/client/dist;
    index index.html;

    # The app shell: always revalidated so new deploys load immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/assettrack-security-headers.conf;
    }

    # Hashed build output. NOTE: /assets/<id> is also a client route (asset
    # detail page), so only paths that look like files are served from disk;
    # anything else falls through to the app shell.
    location /assets/ {
        # Source maps are built ('hidden') for error reporting only; never serve them.
        location ~* \.map$ {
            return 404;
        }
        location ~* \.(?:js|mjs|css|woff2?|ttf|svg|png|jpe?g|gif|webp|avif|ico|json|wasm)$ {
            # A missing chunk is a real 404 (never index.html served as JS).
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
            include /etc/nginx/snippets/assettrack-security-headers.conf;
            access_log off;
        }
        rewrite ^ /index.html last;
    }

    # Source maps anywhere else: not served either.
    location ~* \.map$ {
        return 404;
    }

    location / {
        # Single Page Application: fall back to index.html for client routes
        # (the fallback is served by `location = /index.html` above, no-cache).
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/assettrack-security-headers.conf;
    }

    # 2. Proxy API requests to the Node.js backend (listening on localhost only)
    # No add_header here, so the server-level security headers apply.
    # Set TRUST_PROXY_HOPS=1 in server/.env so the API reads the client IP from
    # X-Forwarded-For (otherwise rate limits see every user as 127.0.0.1).
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Imports of large workbooks can take a while.
        proxy_read_timeout 180s;
        # The API sends its own security headers (helmet); drop them so the
        # server-level ones from the snippet aren't duplicated.
        proxy_hide_header Strict-Transport-Security;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Permissions-Policy;
    }
}
