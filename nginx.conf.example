# Example Nginx configuration for AssetTrack (static web app + API proxy).
# Requires nginx 1.25.1+ for the `http2 on;` directive.

server {
    # Redirect HTTP to HTTPS
    listen 80;
    server_name assettrack.yourcompany.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name assettrack.yourcompany.com;

    # SSL Configuration (assuming Let's Encrypt / Certbot)
    ssl_certificate /etc/letsencrypt/live/assettrack.yourcompany.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/assettrack.yourcompany.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;

    # Excel imports are allowed up to 10 MB and CSV up to 5 MB by the API;
    # nginx's default (1 MB) would reject them first.
    client_max_body_size 12m;

    # Security headers (`always` so they are also sent on error responses)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    # Google Identity Services needs accounts.google.com; fonts come from Google Fonts.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; frame-src https://accounts.google.com/gsi/; connect-src 'self' https://accounts.google.com/gsi/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # 1. Serve the built web app (client/dist after `npm run build`)
    root /var/www/assettrack/client/dist;
    index index.html;

    location / {
        # Single Page Application: fall back to index.html for client routes
        try_files $uri $uri/ /index.html;
    }

    # 2. Proxy API requests to the Node.js backend (listening on localhost only)
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Imports of large workbooks can take a while.
        proxy_read_timeout 180s;
    }
}
